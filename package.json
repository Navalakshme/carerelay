{
  "name": "carerelay",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node scripts/serve.mjs",
    "build": "node scripts/build-static.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check-syntax.mjs && prettier --check .",
    "format": "prettier --write .",
    "test:db": "node scripts/test-database.mjs",
    "test:browser": "playwright test",
    "test:coverage": "node --experimental-test-coverage --test tests/*.test.mjs"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.114.0",
    "cookie": "1.0.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "prettier": "3.10.1"
  }
}
